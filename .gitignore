# ============================================================
# 病案管理系统 .gitignore
# 注意：.gitignore 不支持行尾注释，注释必须独占一行
# ============================================================

# ---------- 运行时产物 ----------
data/
mrs-backend/report-out/
mrs-backend/routes.actual.txt

# ---------- 大体积本地工具与二进制（可重新下载，不入库） ----------
tools/pg/
tools/*.msixbundle
tools/*.tar.gz
tools/*.jar
tools/pwfile.txt
tools/enable-wsl2.log

# ---------- 技能库（agent 工具，不入库；skills-lock.json 保留供还原） ----------
.agents/
.zcode/skills/

# ---------- Go 编译产物 ----------
mrs-backend/mrs
mrs-backend/mrs.exe
mrs-backend/*.exe
*.test

# ---------- 编辑器与本地环境 ----------
.idea/
.vscode/
*.local.yaml
.env

# ---------- Python（契约核对脚本） ----------
__pycache__/
*.pyc

# ---------- 临时文件 ----------
*.tmp

# ---------- 本地工作区数据 / 转码中间产物（不入库，2026-11-06 补） ----------
# 工作区记忆与日志属于本地协作过程，不是项目源码
.workbuddy/
# README 演示 GIF 的抽帧与 Pillow 临时安装目录（由录屏现场重生成）
docs/screenshots/.frames/
docs/screenshots/video-stills/
.tmp-pil/
# 打包分发产物（内容可由仓库重建，不入库）
病案管理系统-打包.zip
